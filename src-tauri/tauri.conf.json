{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NitroDeck Linux",
  "version": "0.1.0",
  "identifier": "com.nitrodeck.linux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NitroDeck Linux",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["polkitd | policykit-1"],
        "files": {
          "/usr/lib/nitrodeck/nitrodeck-fan-watchdog.sh": "../packaging/nitrodeck-fan-watchdog.sh",
          "/usr/lib/systemd/user/nitrodeck-fan-watchdog.service": "../packaging/nitrodeck-fan-watchdog.service",
          "/etc/xdg/autostart/nitrodeck-linux.desktop": "../packaging/nitrodeck-autostart.desktop",
          "/usr/bin/nitrodeck": "../packaging/nitrodeck-cli"
        },
        "postInstallScript": "../packaging/postinst.sh",
        "postRemoveScript": "../packaging/postrm.sh"
      }
    }
  }
}
